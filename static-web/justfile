image := "__IMAGE__"
local_image := "localhost/__NAMESPACE__:local"
base_image := "ghcr.io/static-web-server/static-web-server:2"

serve:
    zola serve --drafts

build:
    zola build

check:
    zola check

_append +crane_args: build
    tar -cf site.tar --owner=0 --group=0 public
    crane append --platform linux/amd64 -b {{base_image}} -f site.tar {{crane_args}}

publish: (_append "-t" image)

image: (_append "-t" local_image "-o" "image.tar")

run: image
    podman load -i image.tar
    podman run --rm -p 8080:8080 -e SERVER_PORT=8080 {{local_image}}

apply:
    kubectl apply -f k8s.yaml

restart:
    kubectl -n __NAMESPACE__ rollout restart deployment/web
    kubectl -n __NAMESPACE__ rollout status deployment/web

rollout: apply restart

deploy: publish rollout
